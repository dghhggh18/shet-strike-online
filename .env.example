# Client: URL of your Socket.IO game server
# Leave empty in Render: client uses same-origin HTTP + Socket.IO automatically.
VITE_SERVER_URL=http://localhost:3001

# Server: set this to the deployed client origin in production
CLIENT_ORIGIN=http://localhost:5173
# Render sets PORT automatically. SHATKI_DATA_FILE should point to a mounted persistent disk.
SHATKI_DATA_FILE=./data/profiles.json
PORT=3001
